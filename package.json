{
  "name": "@rudycity/codebase-wiki-generator",
  "version": "1.0.0",
  "description": "Multi-dimensional codebase wiki generation, C4 architecture diagrams, ERD extraction, API cataloging, and automatic real-time synchronization suite for Single and Federated Multi-Workspace projects.",
  "main": "scripts/sync-wiki-on-change.cjs",
  "bin": {
    "wiki-scaffold": "./scripts/generate-wiki-scaffold.cjs",
