    "wiki-validate-links": "./scripts/validate-wiki-links.cjs",
    "wiki-validate-freshness": "./scripts/validate-wiki-freshness.cjs",
    "wiki-extract-api": "./scripts/extract-api-catalog.cjs",
    "wiki-extract-erd": "./scripts/extract-db-erd.cjs",
    "wiki-rmemory": "./scripts/sync-wiki-to-rmemory.cjs",
    "wiki-hooks": "./scripts/setup-git-hooks.cjs"
  },
  "scripts": {
    "scaffold": "node scripts/generate-wiki-scaffold.cjs",
    "sync": "node scripts/sync-wiki-on-change.cjs",
